test_that("rccheck() runs all steps in order by default", {
  calls <- character()

  local_mocked_bindings(
    document = function(...) {
      calls <<- c(calls, "document")
    },
    test = function(...) {
      calls <<- c(calls, "test")
    },
    check = function(...) {
      calls <<- c(calls, "check")
    },
    .package = "devtools"
  )

  local_mocked_bindings(
    lint_package = function(...) {
      calls <<- c(calls, "lint")
    },
    .package = "lintr"
  )

  rccheck()

  expect_identical(
    calls,
    c("document", "lint", "test", "check")
  )
})


